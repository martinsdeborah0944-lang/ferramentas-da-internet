CREATE TABLE Pessoa(
    cpf CHAR(11) PRIMARY KEY,
    nome VARCHAR(100) NOT NULL,
    email VARCHAR(100) NOT NULL UNIQUE,
    endereco VARCHAR(200)
);

CREATE TABLE Funcionario(
    cpf CHAR(11) PRIMARY KEY,
    matricula INT NOT NULL UNIQUE,
    cargo VARCHAR(50) NOT NULL,
    salario INT NOT NULL,
    data_admissao DATE NOT NULL,
    FOREIGN KEY (cpf) REFERENCES Pessoa(cpf)
);

CREATE TABLE Cliente(
    cpf CHAR(11) PRIMARY KEY,
    data_nasc DATE NOT NULL,
    pts_fidalidade INT NOT NULL,
    data_ultimo_login TIMESTAMP,
    FOREIGN KEY (cpf) REFERENCES Pessoa(cpf)
);

CREATE TABLE Editora(
    cnpj CHAR(14) PRIMARY KEY,
    nome VARCHAR(100) NOT NULL,
    contato VARCHAR(100) NOT NULL
);

CREATE TABLE Categoria(
    id INT PRIMARY KEY,
    nome VARCHAR(80) NOT NULL,
    descricao VARCHAR(250)
);

CREATE TABLE Livro(
    isbn CHAR(13) PRIMARY KEY,
    cnpj_editora CHAR(14) NOT NULL,
    id_categoria INT NOT NULL,
    titulo VARCHAR(150) NOT NULL,
    preco_venda FLOAT NOT NULL,
    ano_publi INT NOT NULL,
    FOREIGN KEY (cnpj_editora) REFERENCES Editora(cnpj),
    FOREIGN KEY (id_categoria) REFERENCES Categoria(id)
);

CREATE TABLE Estoque(
    cod_armaz INT PRIMARY KEY,
    isbn CHAR(13) NOT NULL,
    qntd_livros INT NOT NULL,
    espaco_disponivel INT NOT NULL,
    FOREIGN KEY (isbn) REFERENCES Livro(isbn)
);

CREATE TABLE Autor(
    id_autor INT PRIMARY KEY,
    nome VARCHAR(100) NOT NULL
);

CREATE TABLE Livro_autor(
    isbn CHAR(13),
    id_autor INT,
    PRIMARY KEY (isbn, id_autor),
    FOREIGN KEY (isbn) REFERENCES Livro(isbn),
    FOREIGN KEY (id_autor) REFERENCES Autor(id_autor)
);

CREATE TABLE Pedido_de_venda(
    id INT PRIMARY KEY,
    cpf_cliente CHAR(11) NOT NULL,
    cpf_funcionario CHAR(11) NOT NULL,
    data_p DATE NOT NULL,
    valor_total FLOAT NOT NULL,
    status VARCHAR(25) NOT NULL,
    FOREIGN KEY (cpf_cliente) REFERENCES Cliente(cpf),
    FOREIGN KEY (cpf_funcionario) REFERENCES Funcionario(cpf)
);

CREATE TABLE Item_pedido(
    id INT,
    isbn CHAR(13),
    quantidade INT NOT NULL,
    PRIMARY KEY (id, isbn),
    FOREIGN KEY (id) REFERENCES Pedido_de_venda(id),
    FOREIGN KEY (isbn) REFERENCES Livro(isbn)
);

CREATE TABLE Fornecedor(
    cnpj CHAR(14) PRIMARY KEY,
    nome VARCHAR(100) NOT NULL,
    contato VARCHAR(100) NOT NULL,
    endereco VARCHAR(200) NOT NULL
);

CREATE TABLE Livro_fornecedor(
    isbn CHAR(13),
    cnpj CHAR(14),
    PRIMARY KEY (isbn, cnpj),
    FOREIGN KEY (cnpj) REFERENCES Fornecedor(cnpj),
    FOREIGN KEY (isbn) REFERENCES Livro(isbn)
);

CREATE TABLE Nota_de_entrada(
    id INT PRIMARY KEY,
    cnpj CHAR(14) NOT NULL,
    cpf CHAR(11),
    data_n DATE NOT NULL,
    valor_total FLOAT NOT NULL,
    FOREIGN KEY (cnpj) REFERENCES Fornecedor(cnpj),
    FOREIGN KEY (cpf) REFERENCES Funcionario(cpf)
);

CREATE TABLE Item_de_entrada(
    id INT,
    isbn CHAR(13),
    quantidade INT NOT NULL,
    custo_unitario FLOAT NOT NULL,
    PRIMARY KEY (id, isbn),
    FOREIGN KEY (id) REFERENCES Nota_de_entrada(id),
    FOREIGN KEY (isbn) REFERENCES Livro(isbn)
);

